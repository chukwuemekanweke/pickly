# Package restore and email integration
GITHUB_USERNAME=
GITHUB_PAT=
MAILTRAP_TOKEN=
MAILTRAP_WEBHOOK_SIGNING_SECRET=
MAILTRAP_FROM_ADDRESS=
MAILTRAP_FROM_NAME=BLVK.Pickly.Logistics

# Google Identity Services. No client secret is required for ID-token validation.
GOOGLE_AUTHENTICATION_ENABLED=false
GOOGLE_CLIENT_ID=

# Neon PostgreSQL. Use the direct URL for writes/migrations and the pooled URL for reads.
DATABASE_URL=postgresql://<username>:<password>@<neon-host>/<database>?sslmode=require&channel_binding=require
DATABASE_URL_POOLED=postgresql://<username>:<password>@<neon-pooler-host>/<database>?sslmode=require&channel_binding=require

# Cloudflare R2. Endpoint is the S3 API URL containing the account ID.
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_APPLICATION_FOLDER=backend-project-template
CLOUDFLARE_R2_PUBLIC_BUCKET_NAME=
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://<public-r2-domain>

# Grafana Cloud OTLP gateway for logs, metrics, and traces.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64-credentials>
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Local OTel Collector tail sampling (local profile only; unused in cloud mode).
# OTEL_TAIL_SAMPLING_LATENCY_MS=1000
# OTEL_TAIL_SAMPLING_PERCENTAGE=10

# Grafana Cloud Profiles.
PYROSCOPE_SERVER_ADDRESS=https://profiles-prod-<region>.grafana.net
PYROSCOPE_BASIC_AUTH_USER=<profiles-instance-id>
PYROSCOPE_BASIC_AUTH_PASSWORD=<access-policy-token>

# Cloud RabbitMQ connection.
RABBITMQ_HOSTNAME=<cloud-rabbitmq-host>
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=<cloud-rabbitmq-username>
RABBITMQ_PASSWORD=<cloud-rabbitmq-password>
RABBITMQ_VIRTUAL_HOST=/

# Cloud Redis connection string.
REDIS_CONNECTION_STRING=<cloud-redis-host>:<port>,password=<password>,ssl=True,abortConnect=False
