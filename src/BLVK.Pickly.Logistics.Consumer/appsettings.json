{
  "ConnectionStrings": {
    "PostgresWrite": "Host=localhost;Port=5433;Database=BLVK.Pickly.LogisticsDb;Username=postgres;Password=postgres;",
    "PostgresRead": "Host=localhost;Port=5433;Database=BLVK.Pickly.LogisticsDb;Username=postgres;Password=postgres;",
    "Redis": "localhost:6379"
  },
  "FeatureManagement": {
    "IsMVP": true
  },
  "Messaging": {
    "RabbitMq": {
      "ServiceName": "BLVK.Pickly.Logistics.Consumer",
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "EventsExchange": "x.events.blvkpicklylogistics",
      "CommandsExchange": "x.commands.blvkpicklylogistics"
    }
  },
  "Authentication": {
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Duration": "12:00:00"
    }
  },
  "Notifications": {
    "Delivery": {
      "ApplicationBaseUrl": "https://app.pikly.org/",
      "DisplayTimeZoneId": "Africa/Lagos"
    },
    "Email": {
      "FromAddress": "hello@pikly.org",
      "FromName": "Pikly",
      "TemplateSetsRootPath": "EmailTemplates/TemplateSets",
      "DefaultBrandKey": "default",
      "BaseTemplateFileName": "BaseTemplate.html",
      "NotificationTemplatesFolder": "NotificationTypes",
      "Mailtrap": {
        "ApiToken": "",
        "UseBulkApi": false,
        "InboxId": null,
        "WebhookSigningSecret": ""
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "BLVK.Pickly.Logistics.Consumer",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
