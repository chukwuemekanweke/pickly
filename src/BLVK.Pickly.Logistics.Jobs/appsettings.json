{
  "ConnectionStrings": {
    "PostgresWrite": "Host=localhost;Port=5433;Database=BLVK.Pickly.LogisticsDb;Username=postgres;Password=postgres;",
    "PostgresRead": "Host=localhost;Port=5433;Database=BLVK.Pickly.LogisticsDb;Username=postgres;Password=postgres;",
    "Redis": "localhost:6379"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Authentication": {
    "IpAddressLocationEnrichment": {
      "BatchSize": 50,
      "PollIntervalSeconds": 300,
      "LocationRefreshIntervalDays": 7
    }
  },
  "Jobs": {
    "OutboxProcessing": {
      "BatchSize": 50,
      "PollIntervalSeconds": 30,
      "RetryBaseDelaySeconds": 5,
      "MaxRetryDelaySeconds": 300
    },
    "Payments": {
      "Reconciliation": {
        "BatchSize": 50,
        "PollInterval": "00:00:30",
        "MaxInitiatedAge": "2.00:00:00",
        "StaleThreshold": "00:05:00",
        "RecheckDelay": "00:02:00"
      }
    },
    "Riders": {
      "Matching": {
        "PollInterval": "00:00:10"
      }
    }
  },
  "Riders": {
    "Matching": {
      "LocationFreshness": "00:02:00",
      "MaximumFutureLocationClockSkew": "00:00:30",
      "InitialSearchRadiusMeters": 3000,
      "MaximumSearchRadiusMeters": 15000,
      "SearchRadiusExpansionMeters": 3000,
      "MaximumCandidatesPerRound": 20,
      "OfferTimeout": "00:00:30",
      "MaximumAttemptsPerCycle": 5,
      "RetryBackoff": "00:00:30",
      "MatchingScanBatchSize": 50,
      "ScheduledDispatchScanBatchSize": 50,
      "MaximumConcurrentAssignmentsPerRider": 1,
      "MaximumTransactionRetryCount": 3,
      "TransactionRetryBaseDelay": "00:00:00.025"
    }
  },
  "IpGeolocation": {
    "IpApiCom": {
      "BaseUrl": "http://ip-api.com"
    },
    "IpInfo": {
      "BaseUrl": "https://ipinfo.io",
      "AccessToken": ""
    },
    "IpWhoIs": {
      "BaseUrl": "https://ipwho.is",
      "ApiKey": ""
    }
  },
  "Messaging": {
    "RabbitMq": {
      "ServiceName": "BLVK.Pickly.Logistics.Jobs",
      "HostName": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "EventsExchange": "x.events.blvkpicklylogistics",
      "CommandsExchange": "x.commands.blvkpicklylogistics"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
